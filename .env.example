# Copie para .env e preencha com valores reais antes de subir os containers.
# NUNCA commite o arquivo .env (já está no .gitignore).

PG_DATABASE=smartpark
PG_USER=smartpark_admin
PG_PASSWORD=troque-esta-senha

NODE_RED_CREDENTIAL_SECRET=troque-este-segredo

# Login do editor de flows (https://<dominio>/admin-red)
NODE_RED_ADMIN_USER=admin
# Gere o hash com: python3 -c "import bcrypt; print(bcrypt.hashpw(b'SUA_SENHA', bcrypt.gensalt(10)).decode())"
# IMPORTANTE: coloque o hash entre aspas simples (ele contém $), senão o
# scripts/deploy.sh (que faz "source .env") corrompe o valor.
NODE_RED_ADMIN_PASSWORD_HASH='$2b$10$troque.este.hash.gerado.com.bcrypt'
